{
  "name": "code-a-nova-server",
  "version": "1.0.0",
  "description": "Code-a-Nova Hackathon Registration API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript openapi/openapi.yaml -o src/types/openapi.d.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
